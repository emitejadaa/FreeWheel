generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DELETED
}

enum VerificationStatus {
  UNVERIFIED
  EMAIL_VERIFIED
  PHONE_VERIFIED
  ID_SUBMITTED
  VERIFIED
  REJECTED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  DELETED
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
  OTHER
}

enum DrivetrainType {
  REAR
  FRONT
  FOUR_BY_FOUR
  AWD
}

// Carrocería / segmento del vehículo. Es el dato que alimenta el filtro por
// categoría del buscador ("Explorá por categoría"), así que se guarda en el
// vehículo en vez de derivarse en el front.
enum VehicleCategory {
  SEDAN
  SUV
  BERLINA
  PICKUP
  ELECTRIC
  PREMIUM
  OTHER
}

enum VerificationCodeTargetType {
  EMAIL
  PHONE
}

enum VerificationCodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED_BY_RENTER
  CANCELLED_BY_OWNER
  READY_FOR_PICKUP
  IN_PROGRESS
  RETURN_PENDING
  COMPLETED
  DISPUTED
}

enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  REFUNDED
  FAILED
  DEPOSIT_PAID
  FULLY_PAID
  PARTIALLY_REFUNDED
}

enum PaymentRecordStatus {
  MOCK
  PENDING
  PAID
  REFUNDED
  FAILED
  CANCELLED
  REQUIRES_ACTION
  AUTHORIZED
  CAPTURED
  RELEASED
  PARTIALLY_REFUNDED
}

enum PaymentRecordKind {
  SENA
  BALANCE
  DEPOSIT_HOLD
  DEPOSIT_CAPTURE
  OWNER_TRANSFER
  REFUND
  MOCK
}

enum StripeAccountStatus {
  NONE
  PENDING
  ENABLED
  RESTRICTED
}

enum ContractStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  CANCELLED
}

enum MediaAssetKind {
  PROFILE_PHOTO
  VEHICLE_PHOTO
  DOCUMENT
  SELFIE
  LISTING_PHOTO
}

enum MediaAssetStatus {
  PENDING
  ACTIVE
  DELETED
}

enum MessageType {
  TEXT
  AUDIO
}

model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  password            String
  firstName           String
  lastName            String
  displayName         String?
  phone               String?
  dateOfBirth         DateTime?
  profilePhotoUrl     String?
  role                UserRole            @default(USER)
  status              UserStatus          @default(ACTIVE)
  verificationStatus  VerificationStatus  @default(UNVERIFIED)
  emailVerifiedAt     DateTime?
  acceptedTermsAt     DateTime?
  googleId            String?             @unique
  phoneVerifiedAt     DateTime?
  stripeCustomerId    String?             @unique
  stripeAccountId     String?             @unique
  stripeAccountStatus StripeAccountStatus @default(NONE)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  vehicles                  Vehicle[]
  listings                  Listing[]
  listingAvailabilityBlocks ListingAvailabilityBlock[]
  verifications             UserVerification[]
  verificationCodes         VerificationCode[]
  bookingsAsOwner           Booking[]                  @relation("BookingOwner")
  bookingsAsRenter          Booking[]                  @relation("BookingRenter")
  paymentRecords            PaymentRecord[]
  mediaAssets               MediaAsset[]
  auditLogsAsActor          AuditLog[]                 @relation("AuditActor")
  auditLogsAsTarget         AuditLog[]                 @relation("AuditTargetUser")
  conversationsAsRenter     Conversation[]             @relation("RenterConversations")
  conversationsAsOwner      Conversation[]             @relation("OwnerConversations")
  sentMessages              Message[]                  @relation("SentMessages")
  favorites                 Favorite[]

  @@index([email])
  @@index([status])
  @@index([verificationStatus])
}

model UserVerification {
  id              String             @id @default(uuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          VerificationStatus @default(ID_SUBMITTED)
  documentUrl     String?
  selfieUrl       String?
  dniFrontUrl     String?
  dniBackUrl      String?
  licenseFrontUrl String?
  licenseBackUrl  String?
  notes           String?
  reviewedAt      DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId])
  @@index([status])
}

// Pre-account email verification: holds the hashed code sent to an email that
// has no User row yet (VerificationCode requires a userId FK). One live row per
// email; re-requesting a code upserts (rotates hash, resets attempts). The row
// is deleted in the same transaction that creates the User.
model PendingRegistration {
  id          String    @id @default(uuid())
  email       String    @unique
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([expiresAt])
}

model VerificationCode {
  id          String                     @id @default(uuid())
  userId      String
  user        User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  targetType  VerificationCodeTargetType
  targetValue String
  purpose     VerificationCodePurpose    @default(EMAIL_VERIFICATION)
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int                        @default(0)
  maxAttempts Int                        @default(5)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@index([userId, targetType, consumedAt])
  @@index([expiresAt])
}

model Vehicle {
  id                            String            @id @default(uuid())
  ownerId                       String
  owner                         User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  brand                         String
  model                         String
  year                          Int
  category                      VehicleCategory?
  plate                         String?
  color                         String?
  seats                         Int?
  transmission                  TransmissionType?
  fuelType                      FuelType?
  drivetrain                    DrivetrainType?
  bluetooth                     Boolean?
  rearCamera                    Boolean?
  parkingSensors                Boolean?
  fuelConsumptionLitersPer100Km Float?
  doors                         Int?
  trunkCapacityLiters           Int?
  widthMm                       Int?
  lengthMm                      Int?
  heightMm                      Int?
  weightKg                      Int?
  horsePower                    Int?
  engineDisplacementCC          Int?
  observations                  String?
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt

  listings Listing[]
  bookings Booking[]

  @@index([ownerId])
  @@index([brand, model])
  @@index([category])
}

model Listing {
  id                String        @id @default(uuid())
  vehicleId         String
  ownerId           String
  vehicle           Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  owner             User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  title             String
  description       String
  pricePerDay       Float
  locationText      String
  latitude          Float?
  longitude         Float?
  deliveryLatitude  Float?
  deliveryLongitude Float?
  deliveryRadiusKm  Float?
  status            ListingStatus @default(DRAFT)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  bookings           Booking[]
  availabilityBlocks ListingAvailabilityBlock[]
  conversations      Conversation[]
  favorites          Favorite[]

  @@index([ownerId])
  @@index([vehicleId])
  @@index([status, createdAt])
}

// "Me gusta" de un usuario sobre una publicación. Vive en la base (y no en el
// navegador) para que los favoritos sigan estando al cambiar de dispositivo.
model Favorite {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId, createdAt])
  @@index([listingId])
}

model ListingAvailabilityBlock {
  id        String   @id @default(uuid())
  listingId String
  ownerId   String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId, startDate, endDate])
  @@index([ownerId])
}

model Booking {
  id                     String        @id @default(uuid())
  listingId              String
  vehicleId              String
  ownerId                String
  renterId               String
  listing                Listing       @relation(fields: [listingId], references: [id], onDelete: Restrict)
  vehicle                Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  owner                  User          @relation("BookingOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  renter                 User          @relation("BookingRenter", fields: [renterId], references: [id], onDelete: Restrict)
  startDate              DateTime
  endDate                DateTime
  status                 BookingStatus @default(REQUESTED)
  pricePerDaySnapshot    Float
  totalPriceSnapshot     Float
  currency               String        @default("ARS")
  pickupTokenHash        String?
  returnTokenHash        String?
  pickupTokenPreview     String?
  returnTokenPreview     String?
  pickupConfirmedAt      DateTime?
  returnConfirmedAt      DateTime?
  cancelledAt            DateTime?
  cancellationReason     String?
  paymentStatus          PaymentStatus @default(NOT_REQUIRED)
  paymentProvider        String?
  providerPaymentId      String?
  platformFeeSnapshot    Float?
  depositSnapshot        Float?
  rentalSubtotalSnapshot Float?
  insuranceSnapshot      Float?
  senaAmountSnapshot     Float?
  balanceAmountSnapshot  Float?
  ownerPayoutSnapshot    Float?
  transferGroup          String?
  ownerTransferId        String?
  depositPaymentIntentId String?
  depositCapturedAmount  Float?
  paidAt                 DateTime?
  refundedAt             DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  paymentRecords PaymentRecord[]
  contract       Contract?

  @@index([listingId])
  @@index([vehicleId])
  @@index([ownerId])
  @@index([renterId])
  @@index([status])
  @@index([startDate, endDate])
}

model PaymentRecord {
  id                    String              @id @default(uuid())
  bookingId             String?
  userId                String?
  booking               Booking?            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user                  User?               @relation(fields: [userId], references: [id], onDelete: Restrict)
  status                PaymentRecordStatus @default(MOCK)
  kind                  PaymentRecordKind?
  provider              String?
  providerId            String?
  stripePaymentIntentId String?             @unique
  stripeChargeId        String?
  stripeTransferId      String?
  stripeRefundId        String?
  amount                Float?
  amountMinor           Int?
  applicationFeeMinor   Int?
  currency              String              @default("ARS")
  metadata              Json?
  paidAt                DateTime?
  refundedAt            DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([bookingId])
  @@index([userId])
  @@index([status])
  @@index([kind])
}

model MediaAsset {
  id              String           @id @default(uuid())
  ownerId         String
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  entityType      String?
  entityId        String?
  kind            MediaAssetKind
  url             String
  storageProvider String?
  storageKey      String?
  mimeType        String?
  sizeBytes       Int?
  status          MediaAssetStatus @default(ACTIVE)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([ownerId])
  @@index([entityType, entityId])
  @@index([kind])
  @@index([status])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  targetUserId String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUser   User?    @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  action       String
  entityType   String
  entityId     String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([targetUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model Conversation {
  id            String    @id @default(uuid())
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Restrict)
  renterId      String
  renter        User      @relation("RenterConversations", fields: [renterId], references: [id], onDelete: Restrict)
  ownerId       String
  owner         User      @relation("OwnerConversations", fields: [ownerId], references: [id], onDelete: Restrict)
  messages      Message[]
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([listingId, renterId])
  @@index([renterId])
  @@index([ownerId])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)
  type           MessageType  @default(TEXT)
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
}

model StripeEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  type        String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([type])
}

model Contract {
  id               String         @id @default(uuid())
  bookingId        String         @unique
  booking          Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  status           ContractStatus @default(PENDING_ACCEPTANCE)
  terms            Json
  pdfStorageKey    String?
  pdfUrl           String?
  renterAcceptedAt DateTime?
  ownerAcceptedAt  DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
}
