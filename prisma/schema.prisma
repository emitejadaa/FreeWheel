generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING_VERIFICATION
  SUSPENDED
  DELETED
}

enum VerificationStatus {
  UNVERIFIED
  EMAIL_VERIFIED
  PHONE_VERIFIED
  ID_SUBMITTED
  VERIFIED
  REJECTED
}

/// Qué documento cubre un DocumentVerification. Los dos flujos son
/// independientes: se pueden verificar juntos o cada uno por su lado.
enum VerifiedDocumentType {
  DNI
  LICENSE
}

/// Estado de la verificación de UN documento.
///
/// DNI y licencia son dos flujos independientes: cada uno nace, falla y se
/// aprueba por su cuenta, y verificar uno no obliga a verificar el otro.
///
/// - PENDING: las fotos están subidas y todavía no hay veredicto. Es el estado
///   con el que nace toda submission y también donde queda cuando la lectura
///   automática no se pudo hacer (servicio caído, sin configurar): un problema
///   nuestro no puede contar como un documento fallado.
/// - FAILED: la lectura automática se hizo y NO cerró. `reasonCodes` dice
///   exactamente qué falló y sobre qué foto. Las fotos NO se borran: el usuario
///   elige entre mandar otras (y ahí sí se borran las viejas) o pedir que un
///   admin mire estas mismas. Lo que no se puede es volver a analizar las
///   mismas fotos: ya tienen veredicto.
/// - MANUAL_REVIEW: el usuario pidió la revisión; espera a un admin.
/// - APPROVED: el documento quedó verificado, por la lectura automática o por
///   un admin. Recién acá los datos declarados se copian a la cuenta.
/// - REJECTED: un admin lo rechazó; los archivos se borran del storage.
enum DocumentVerificationStatus {
  PENDING
  APPROVED
  FAILED
  MANUAL_REVIEW
  REJECTED
}

/// En qué anda la LECTURA AUTOMÁTICA de un documento, que es una cosa distinta
/// del estado de la verificación.
///
/// `status` dice si el documento está aprobado; esto dice si la máquina ya lo
/// miró. Se separan porque avanzan por caminos distintos: un documento puede
/// estar PENDING con el análisis DONE (la lectura salió bien pero algo no
/// cerró y lo mira un admin) o PENDING con el análisis FAILED (el servicio de
/// lectura estaba caído, y entonces lo resuelve un admin igual). Mezclarlos en
/// un solo campo obligaba al front a adivinar cuál de las dos cosas estaba
/// esperando.
enum DocumentAnalysisStatus {
  /// Todavía no se pidió: el documento se acaba de enviar.
  NOT_REQUESTED
  /// La API de lectura lo aceptó y está en su cola.
  QUEUED
  /// Terminó y el veredicto ya se aplicó.
  DONE
  /// No se pudo leer. `analysisError` dice por qué, y el documento sigue su
  /// camino por revisión manual: un problema nuestro no puede dejar trabada a
  /// una persona.
  FAILED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  DELETED
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
}

enum FuelType {
  GASOLINE
  DIESEL
  HYBRID
  ELECTRIC
  OTHER
}

enum DrivetrainType {
  REAR
  FRONT
  FOUR_BY_FOUR
  AWD
}

// Carrocería / segmento del vehículo. Es el dato que alimenta el filtro por
// categoría del buscador ("Explorá por categoría"), así que se guarda en el
// vehículo en vez de derivarse en el front.
enum VehicleCategory {
  SEDAN
  HATCHBACK
  SUV
  PICKUP
  VAN
  /// Las dos carrocerías de un auto deportivo: dos puertas techo fijo (COUPE) y
  /// dos puertas techo rebatible (CONVERTIBLE). Reemplazan a PREMIUM, que no era
  /// una carrocería sino una etiqueta de precio.
  COUPE
  CONVERTIBLE
  ELECTRIC
  /// PREMIUM no es un tipo de auto: es una opinión sobre el precio. Un particular
  /// no alquila un deportivo de colección, y "premium" no le dice a nadie qué
  /// auto está mirando. Se dejó de ofrecer al publicar y quien busca un auto así
  /// ahora elige COUPE o CONVERTIBLE, que sí describen el auto.
  /// Queda en el enum porque hay publicaciones que ya lo usan; el front las
  /// muestra deduciendo la carrocería de las medidas del vehículo.
  PREMIUM
  /// "Berlina" es la palabra castellana para sedán: era un duplicado de SEDAN y
  /// se dejó de ofrecer al publicar. Sigue acá porque hay publicaciones que ya lo
  /// usan y quitar un valor de un enum obliga a reescribir la columna. El front
  /// lo muestra como "Sedán".
  BERLINA
  OTHER
}

/// Quién puede ver la foto de perfil de una persona.
///
/// Existe porque una foto de perfil es una cara: hay gente que la quiere puesta
/// para que la reconozcan cuando va a entregar el auto, y gente que no la quiere
/// a la vista de cualquiera que entre a la app. Antes había una sola respuesta
/// para las dos —la foto se veía siempre— y quien no estuviera de acuerdo no
/// tenía más opción que no poner ninguna.
enum PhotoVisibility {
  /// Cualquier persona con la sesión abierta: la lista de chats, el encabezado
  /// de una conversación, la publicación de un auto y las reseñas.
  EVERYONE
  /// Solo las personas con las que hay o hubo una reserva en común. Para el
  /// resto se muestra el círculo con la inicial, igual que si no tuviera foto.
  BOOKED
}

enum VerificationCodeTargetType {
  EMAIL
  PHONE
}

enum VerificationCodePurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  // Confirmación por email para cambiar el precio de una publicación.
  PRICE_CHANGE
  /// Cambio de la dirección de email de la cuenta. El código se manda a la
  /// dirección NUEVA (que queda guardada en targetValue) y el email de la cuenta
  /// no se toca hasta que ese código se confirma: es la única forma de saber que
  /// la dirección nueva existe y es de quien la está poniendo.
  EMAIL_CHANGE
}

/// A quién apunta un reporte hecho por una persona.
enum ReportTargetType {
  LISTING
  USER
}

enum ReportStatus {
  OPEN // recién entrado, esperando que un admin lo mire
  ACTION_TAKEN // el admin actuó (pausó o eliminó la publicación, etc.)
  DISMISSED // el admin lo descartó
}

/// Qué dijo la IA al leer el reporte y compararlo con la publicación.
enum ReportAiVerdict {
  COHERENT // lo que se denuncia se corresponde con la publicación
  INCOHERENT // no tiene relación con la publicación
  UNCLEAR // no alcanza para decidir
}

/// En qué anda un reclamo por daño del dueño sobre el depósito en garantía.
enum DamageClaimStatus {
  OPEN // el dueño lo abrió, espera que un admin lo resuelva
  ACCEPTED // se cobró del depósito (total o parte)
  REJECTED // no corresponde: el depósito se libera entero
}

enum BookingStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  CANCELLED_BY_RENTER
  CANCELLED_BY_OWNER
  READY_FOR_PICKUP
  IN_PROGRESS
  RETURN_PENDING
  COMPLETED
  DISPUTED
}

/// El resumen del estado de pago de UNA reserva. Es derivado de los
/// PaymentRecord y existe para no tener que sumarlos en cada consulta.
enum PaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  REFUNDED
  FAILED
  DEPOSIT_PAID
  FULLY_PAID
  PARTIALLY_REFUNDED
  /// El titular de la tarjeta desconoció un cobro de esta reserva. Es el
  /// estado más caro: la plata puede irse del saldo de la plataforma, así que
  /// frena la liquidación al dueño hasta que se resuelva.
  DISPUTED
}

/// En qué anda UN cobro concreto. Sigue el ciclo de un PaymentIntent de
/// Stripe, que es el modelo de referencia de toda esta parte.
///
///   REQUIRES_ACTION → el intent existe y espera que el cliente pague o
///                     complete la autenticación (3-D Secure).
///   PROCESSING      → el medio de pago se está procesando (débitos, algunos
///                     métodos locales). No es ni éxito ni fracaso todavía.
///   AUTHORIZED      → la plata está retenida pero no cobrada. Es el estado
///                     del depósito en garantía.
///   CAPTURED / PAID → cobrado de verdad.
///   RELEASED        → una retención que se soltó sin cobrar.
///   PARTIALLY_REFUNDED / REFUNDED → devuelto en parte o entero.
///   DISPUTED        → el titular de la tarjeta desconoció el cobro. Es plata
///                     que puede irse: bloquea la liquidación al dueño.
///   FAILED          → el pago no se pudo hacer. `failureCode` dice por qué.
///   CANCELLED       → el intent se dio de baja antes de cobrarse.
///   MOCK            → filas del provider offline que se usa en los tests.
enum PaymentRecordStatus {
  MOCK
  PENDING
  PAID
  REFUNDED
  FAILED
  CANCELLED
  REQUIRES_ACTION
  PROCESSING
  AUTHORIZED
  CAPTURED
  RELEASED
  PARTIALLY_REFUNDED
  DISPUTED
}

enum PaymentRecordKind {
  SENA
  BALANCE
  DEPOSIT_HOLD
  DEPOSIT_CAPTURE
  OWNER_TRANSFER
  REFUND
  MOCK
}

enum StripeAccountStatus {
  NONE
  PENDING
  ENABLED
  RESTRICTED
}

enum ContractStatus {
  PENDING_ACCEPTANCE
  ACCEPTED
  CANCELLED
}

enum MediaAssetKind {
  PROFILE_PHOTO
  VEHICLE_PHOTO
  DOCUMENT
  SELFIE
  LISTING_PHOTO
}

enum MediaAssetStatus {
  PENDING
  ACTIVE
  DELETED
}

enum MessageType {
  TEXT
  AUDIO
}

model User {
  id                      String              @id @default(uuid())
  email                   String              @unique
  password                String
  firstName               String
  lastName                String
  displayName             String?
  /// El teléfono de contacto de la cuenta, en formato E.164 (+54911...). Único
  /// como el email: es el número al que se manda el código de verificación y el
  /// que ve la otra parte de una reserva, así que dos cuentas con el mismo
  /// número son una sola persona haciéndose pasar por dos. La normalización a
  /// E.164 (phone.validator.ts) es lo que hace que el índice sirva: sin ella
  /// "+5491132895416" y "011 3289-5416" entrarían como dos números distintos.
  phone                   String?             @unique
  dateOfBirth             DateTime?
  /// Datos de identidad que CARGA LA PERSONA. La revisión documental los cruza
  /// contra lo que dicen el DNI y la licencia, y ese cruce es lo único que hace
  /// la lectura automática: ningún dato sale de la foto para entrar acá.
  ///
  /// El domicilio ya no está y no es un olvido. No se comparaba contra nada, no
  /// habilitaba nada, y era el dato más sensible que guardábamos de una persona.
  /// La dirección que el sistema sí necesita es la del auto, y esa vive en
  /// Listing.locationText.
  ///
  /// Quedan inmutables una vez que hay un documento aprobado contra ellos.
  /// Unicidad nullable: una misma identidad no puede respaldar dos cuentas
  /// (antifraude a nivel base).
  dni                     String?             @unique
  cuil                    String?             @unique
  profilePhotoUrl         String?
  /// La foto de perfil SIN RECORTAR, tal como se subió.
  ///
  /// `profilePhotoUrl` guarda el RECORTE, que es lo que se muestra en todos
  /// lados. Con solo eso, volver a encuadrar la foto significaba recortar sobre
  /// el recorte anterior: cada vuelta achicaba la imagen un poco más y no había
  /// forma de volver atrás, porque lo que quedaba afuera ya no existía en
  /// ninguna parte.
  ///
  /// Guardando también la original, el editor siempre reencuadra sobre la foto
  /// entera y el zoom se puede deshacer. No la ve nadie más que su dueño: no va
  /// en los selects públicos, porque es la foto sin el encuadre que la persona
  /// eligió mostrar.
  profilePhotoOriginalUrl String?
  /// Quién ve la foto de arriba. Se elige en el perfil y se puede cambiar cuando
  /// se quiera. Por defecto la ve todo el mundo: si alguien se tomó el trabajo de
  /// subir una foto es para que se vea, y quien prefiera lo contrario lo cambia
  /// en dos toques.
  profilePhotoVisibility  PhotoVisibility     @default(EVERYONE)
  /// Si esta persona quiere recibir avisos por mail: reservas pedidas,
  /// aceptadas, pagos, entregas y devoluciones, y el aviso de que tiene
  /// mensajes sin leer en el chat.
  ///
  /// NO alcanza a los mails de seguridad —el código para entrar, el de cambiar
  /// el email, el link para recuperar la contraseña, el código para cambiar el
  /// precio de una publicación—: esos no son avisos, son la forma de poder usar
  /// la cuenta, y salen aunque esto esté apagado.
  ///
  /// Arranca en true: quien no quiera recibirlos lo apaga en Ajustes, y así
  /// ninguna cuenta que ya existía cambia de comportamiento.
  emailNotifications      Boolean             @default(true)
  /// Cuándo se mandó el último aviso de "tenés mensajes sin leer". Sin esto, una
  /// charla de veinte mensajes serían veinte mails.
  lastUnreadEmailAt       DateTime?
  role                    UserRole            @default(USER)
  status                  UserStatus          @default(ACTIVE)
  verificationStatus      VerificationStatus  @default(UNVERIFIED)
  /// ── LO QUE DICEN LOS DOCUMENTOS, DECLARADO POR SU DUEÑO ──────────────────
  ///
  /// Estos campos los escribe LA PERSONA al enviar cada documento, y se copian
  /// acá recién cuando ese documento queda APROBADO. O sea: son datos
  /// declarados que la lectura del documento corroboró.
  ///
  /// NO SALEN DEL OCR, y el cambio es deliberado. Cuando salían de la foto, un
  /// vencimiento mal leído dejaba la cuenta verificada pero sin poder reservar,
  /// y la persona no tenía forma de corregirlo: el dato equivocado lo había
  /// puesto la máquina. Ahora el dato lo pone quien lo puede leer con los ojos
  /// y la máquina solo dice si coincide con la foto.
  ///
  /// Están acá arriba y no solo en DocumentVerification porque son los que
  /// deciden, en CADA pedido, qué puede hacer esta persona. JwtStrategy ya trae
  /// el usuario entero, así que ese control no cuesta una consulta más.
  ///
  /// Los vencimientos se comparan contra la fecha de hoy en el momento de
  /// usarlos y no los revisa ningún proceso programado: un job nocturno dejaría
  /// una ventana entre que el documento vence y alguien se entera.
  licenseExpiresAt        DateTime?
  /// Clase de la licencia (B.1, A2.2, C...). Solo las que incluyen auto
  /// particular habilitan a alquilar: una clase A es de moto.
  licenseClass            String?
  /// Desde cuándo tiene licencia.
  licenseIssuedAt         DateTime?
  /// Hasta cuándo dura el período de principiante, si la licencia lo tiene.
  licenseBeginnerUntil    DateTime?
  /// Cuándo vence el DNI. Vencido, la cuenta sigue VERIFICADA —la persona no
  /// dejó de ser quien es— pero no puede hacer nada sensible: es su identidad
  /// la que quedó sin respaldo vigente.
  dniExpiresAt            DateTime?
  emailVerifiedAt         DateTime?
  acceptedTermsAt         DateTime?
  googleId                String?             @unique
  phoneVerifiedAt         DateTime?
  stripeCustomerId        String?             @unique
  stripeAccountId         String?             @unique
  stripeAccountStatus     StripeAccountStatus @default(NONE)
  /// Promedio de las reseñas recibidas y cuántas son. Se guardan calculados para
  /// no tener que recorrer todas las reseñas cada vez que se muestra un perfil.
  ratingAverage           Float?
  ratingCount             Int                 @default(0)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  vehicles                  Vehicle[]
  listings                  Listing[]
  listingAvailabilityBlocks ListingAvailabilityBlock[]
  documentVerifications     DocumentVerification[]
  verificationCodes         VerificationCode[]
  bookingsAsOwner           Booking[]                  @relation("BookingOwner")
  bookingsAsRenter          Booking[]                  @relation("BookingRenter")
  paymentRecords            PaymentRecord[]
  mediaAssets               MediaAsset[]
  auditLogsAsActor          AuditLog[]                 @relation("AuditActor")
  auditLogsAsTarget         AuditLog[]                 @relation("AuditTargetUser")
  conversationsAsRenter     Conversation[]             @relation("RenterConversations")
  conversationsAsOwner      Conversation[]             @relation("OwnerConversations")
  sentMessages              Message[]                  @relation("SentMessages")
  favorites                 Favorite[]
  reviewsWritten            Review[]                   @relation("ReviewAuthor")
  reviewsReceived           Review[]                   @relation("ReviewTarget")
  reportsMade               Report[]                   @relation("Reporter")
  reportsReceived           Report[]                   @relation("ReportedUser")
  reportsResolved           Report[]                   @relation("ReportResolver")
  damageClaimsMade          DamageClaim[]              @relation("DamageClaimOwner")
  damageClaimsResolved      DamageClaim[]              @relation("DamageClaimResolver")

  @@index([email])
  @@index([status])
  @@index([verificationStatus])
}

model DocumentVerification {
  id                  String                     @id @default(uuid())
  userId              String
  user                User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  type                VerifiedDocumentType
  status              DocumentVerificationStatus
  frontUrl            String?
  backUrl             String?
  /// Número de documento asociado a esta verificación. Sale del DNI que la
  /// persona declaró en su perfil, NO de la foto. Sostiene el control
  /// antifraude: una misma identidad no puede quedar aprobada en dos cuentas.
  documentNumber      String?
  /// Cuándo vence ESTE documento, según lo DECLARADO por su dueño y
  /// corroborado por la lectura. Es el dato que después decide qué puede hacer
  /// la persona: una licencia vencida no habilita a manejar por más que la
  /// cuenta esté verificada.
  expiresAt           DateTime?
  /// LO QUE LA PERSONA DECLARÓ SOBRE ESTE DOCUMENTO al enviarlo: vencimiento
  /// y, en la licencia, otorgamiento, clase y período de principiante.
  ///
  /// Es el único origen de estos datos. La lectura automática no los escribe:
  /// los COMPARA contra la foto, y si coinciden el documento se aprueba y
  /// estos valores se copian a la cuenta. Guardarlo por submission (y no solo
  /// en User) es lo que permite auditar contra qué se comparó la foto que se
  /// aprobó, incluso después de que la persona reenvíe el documento.
  declared            Json?
  /// Motivo del último veredicto, con el mensaje completo guardado adentro
  /// para que las filas viejas se sigan mostrando aunque su código ya no esté
  /// en el catálogo.
  matchReport         Json?
  /// Los mismos motivos en códigos estables, aptos para que el front ramifique.
  reasonCodes         String[]                   @default([])
  /// Qué FOTOS hay que volver a sacar ("dni_front", "license_back"). Sale del
  /// veredicto y se guarda aparte de los motivos porque es lo que el front
  /// necesita para decirle a la persona cuál repetir y cuál puede reutilizar,
  /// sin tener que interpretar una lista de códigos.
  retakeSlots         String[]                   @default([])
  /// EL RESULTADO DEL CRUCE, SIN LOS VALORES LEÍDOS.
  ///
  /// Guarda, por campo, si la foto coincidió con lo declarado, cuántos
  /// orígenes lo confirmaron y si esos orígenes decían todos lo mismo. NO
  /// guarda lo que la foto decía: eso es dato personal que ya tenemos
  /// declarado, y duplicarlo desde una lectura automática que puede
  /// equivocarse es guardar un dato peor por las dudas.
  checks              Json?
  /// En qué anda la lectura automática, y por qué falló si falló. El mensaje
  /// se le muestra al usuario, así que dice qué pasó en castellano y no un
  /// stack trace.
  analysisStatus      DocumentAnalysisStatus     @default(NOT_REQUESTED)
  analysisRequestedAt DateTime?
  analysisError       String?
  /// SHA-256 del token de un solo uso que la API de lectura tiene que devolver
  /// al avisar que terminó. Se guarda hasheado por lo mismo que una
  /// contraseña: quien pueda leer la base no puede con eso falsificar el aviso
  /// de un análisis. Se borra al consumirlo, y eso es lo que lo hace de un
  /// solo uso.
  analysisTokenHash   String?                    @unique
  /// Revisión manual: cuándo la pidió el usuario y quién/cuándo la resolvió.
  reviewRequestedAt   DateTime?
  reviewedBy          String?
  reviewedAt          DateTime?
  notes               String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  /// Una fila viva por documento y usuario: reenviar fotos reemplaza la
  /// anterior (y borra sus archivos). El historial queda en AuditLog.
  @@unique([userId, type])
  @@index([status])
  @@index([documentNumber])
}

// Pre-account email verification: holds the hashed code sent to an email that
// has no User row yet (VerificationCode requires a userId FK). One live row per
// email; re-requesting a code upserts (rotates hash, resets attempts). The row
// is deleted in the same transaction that creates the User.
model PendingRegistration {
  id          String    @id @default(uuid())
  email       String    @unique
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([expiresAt])
}

model VerificationCode {
  id          String                     @id @default(uuid())
  userId      String
  user        User                       @relation(fields: [userId], references: [id], onDelete: Restrict)
  targetType  VerificationCodeTargetType
  targetValue String
  purpose     VerificationCodePurpose    @default(EMAIL_VERIFICATION)
  codeHash    String
  expiresAt   DateTime
  consumedAt  DateTime?
  attempts    Int                        @default(0)
  maxAttempts Int                        @default(5)
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@index([userId, targetType, consumedAt])
  @@index([expiresAt])
}

model Vehicle {
  id                            String            @id @default(uuid())
  ownerId                       String
  owner                         User              @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  brand                         String
  model                         String
  year                          Int
  category                      VehicleCategory?
  plate                         String?
  color                         String?
  seats                         Int?
  transmission                  TransmissionType?
  fuelType                      FuelType?
  drivetrain                    DrivetrainType?
  bluetooth                     Boolean?
  rearCamera                    Boolean?
  parkingSensors                Boolean?
  fuelConsumptionLitersPer100Km Float?
  doors                         Int?
  trunkCapacityLiters           Int?
  widthMm                       Int?
  lengthMm                      Int?
  heightMm                      Int?
  weightKg                      Int?
  horsePower                    Int?
  engineDisplacementCC          Int?
  observations                  String?
  createdAt                     DateTime          @default(now())
  updatedAt                     DateTime          @updatedAt

  listings Listing[]
  bookings Booking[]

  @@index([ownerId])
  @@index([brand, model])
  @@index([category])
}

model Listing {
  id          String  @id @default(uuid())
  vehicleId   String
  ownerId     String
  vehicle     Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  owner       User    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  title       String
  description String
  pricePerDay Float

  /// ── Dónde está el auto y hasta dónde lo llevan ──────────────────────────
  /// Un solo punto: `locationText` es la dirección escrita y `latitude`/
  /// `longitude` son ESE MISMO punto, no otro. El front los mantiene en sincro
  /// (se mueve el pin y se reescribe la dirección, y al revés), y el back los
  /// recibe y los devuelve juntos siempre.
  ///
  /// Son opcionales en la base sólo por los avisos que se publicaron antes de
  /// que se pidieran; al crear uno nuevo son obligatorios (CreateListingDto).
  locationText String
  latitude     Float?
  longitude    Float?

  /// Cuántos metros a la redonda de ESE punto el dueño está dispuesto a llevar
  /// el auto. 0 = no hay entrega, se retira en el lugar. En metros y no en
  /// kilómetros porque es lo que mueve el slider del front, y un entero evita
  /// que "5 km" y "5000 m" convivan como dos formas del mismo dato.
  deliveryRadiusM Int @default(0)

  status ListingStatus @default(DRAFT)

  /// Promedio de las reseñas de esta publicación y cuántas son. Calculados y
  /// guardados: es el número que se muestra en el listado y en el detalle.
  ratingAverage Float?
  ratingCount   Int    @default(0)

  /// Cambio de precio pendiente de confirmar por email, y cuándo se pidió.
  /// El precio no se toca hasta que la persona confirma con el código.
  pendingPricePerDay     Float?
  priceChangeRequestedAt DateTime?
  /// Última vez que el precio cambió de verdad. Se usa para el tiempo de espera
  /// entre cambios.
  priceUpdatedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings           Booking[]
  availabilityBlocks ListingAvailabilityBlock[]
  conversations      Conversation[]
  favorites          Favorite[]
  reviews            Review[]
  reports            Report[]

  @@index([ownerId])
  @@index([vehicleId])
  @@index([status, createdAt])
}

// "Me gusta" de un usuario sobre una publicación. Vive en la base (y no en el
// navegador) para que los favoritos sigan estando al cambiar de dispositivo.
model Favorite {
  id        String   @id @default(uuid())
  userId    String
  listingId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId, createdAt])
  @@index([listingId])
}

model ListingAvailabilityBlock {
  id        String   @id @default(uuid())
  listingId String
  ownerId   String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  startDate DateTime
  endDate   DateTime
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId, startDate, endDate])
  @@index([ownerId])
}

model Booking {
  id                     String        @id @default(uuid())
  listingId              String
  vehicleId              String
  ownerId                String
  renterId               String
  listing                Listing       @relation(fields: [listingId], references: [id], onDelete: Restrict)
  vehicle                Vehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  owner                  User          @relation("BookingOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  renter                 User          @relation("BookingRenter", fields: [renterId], references: [id], onDelete: Restrict)
  startDate              DateTime
  endDate                DateTime
  status                 BookingStatus @default(REQUESTED)
  pricePerDaySnapshot    Float
  totalPriceSnapshot     Float
  currency               String        @default("ARS")
  pickupTokenHash        String?
  returnTokenHash        String?
  pickupTokenPreview     String?
  returnTokenPreview     String?
  pickupConfirmedAt      DateTime?
  returnConfirmedAt      DateTime?
  cancelledAt            DateTime?
  cancellationReason     String?
  paymentStatus          PaymentStatus @default(NOT_REQUIRED)
  paymentProvider        String?
  providerPaymentId      String?
  platformFeeSnapshot    Float?
  depositSnapshot        Float?
  rentalSubtotalSnapshot Float?
  insuranceSnapshot      Float?
  senaAmountSnapshot     Float?
  balanceAmountSnapshot  Float?
  ownerPayoutSnapshot    Float?
  transferGroup          String?
  ownerTransferId        String?
  depositPaymentIntentId String?
  depositCapturedAmount  Float?
  /// Cuándo el dueño revisó el auto devuelto y dijo que estaba todo bien.
  ///
  /// Cierra la ventana de revisión antes de tiempo (ver claims/claim-window.ts)
  /// y es lo que hace que el botón de revisar DESAPAREZCA. Sin esta marca, la
  /// pantalla no tenía forma de saber que el dueño ya había mirado el auto: el
  /// botón seguía ahí para siempre y se podía apretar infinitas veces, cada una
  /// diciendo que la garantía se liberaba cuando ya estaba liberada.
  ownerInspectedAt       DateTime?
  paidAt                 DateTime?
  refundedAt             DateTime?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  paymentRecords PaymentRecord[]
  contract       Contract?
  reviews        Review[]
  damageClaims   DamageClaim[]

  @@index([listingId])
  @@index([vehicleId])
  @@index([ownerId])
  @@index([renterId])
  @@index([status])
  @@index([startDate, endDate])
}

/// EL RECLAMO DE UN DAÑO SOBRE EL DEPÓSITO EN GARANTÍA.
///
/// Lo abre el DUEÑO cuando revisa el auto devuelto y encuentra algo. No cobra
/// nada por sí solo: lo resuelve un administrador, que es quien captura del
/// depósito. Si el dueño pudiera cobrar solo, el depósito sería un botón para
/// quedarse con la garantía de quien alquiló sin que nadie mire, y las dos
/// partes tienen intereses opuestos justamente acá.
///
/// El depósito NO se libera al confirmarse la devolución: queda retenido
/// mientras dura la ventana de revisión del dueño (ver claims/claim-window.ts).
/// Sin esa ventana un reclamo llegaría siempre tarde, porque la retención ya
/// estaría soltada y no habría nada que capturar.
model DamageClaim {
  id        String @id @default(uuid())
  bookingId String
  /// Quién reclama: siempre el dueño del auto.
  ownerId   String

  /// Qué pasó, escrito por el dueño. Es lo que va a leer quien alquiló cuando
  /// pregunte por qué le cobraron, así que se guarda entero.
  description String

  /// Cuánto pide, en centavos. No es lo que se cobra: es lo que reclama. Lo
  /// que efectivamente se cobra lo decide el admin y queda en capturedAmountMinor.
  claimedAmountMinor Int

  /// Las fotos del daño (URLs de Cloudinary). Sin al menos una no se puede
  /// abrir: un reclamo sin fotos es la palabra de uno contra la del otro, y
  /// deja al admin sin nada con que decidir sobre plata ajena.
  evidenceUrls String[]

  status DamageClaimStatus @default(OPEN)

  /// Resolución del admin.
  resolvedById        String?
  resolvedAt          DateTime?
  resolutionNote      String?
  /// Lo que finalmente se capturó del depósito, en centavos.
  capturedAmountMinor Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking    Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  owner      User    @relation("DamageClaimOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  resolvedBy User?   @relation("DamageClaimResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([bookingId])
}

model PaymentRecord {
  id                    String              @id @default(uuid())
  bookingId             String?
  userId                String?
  booking               Booking?            @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  user                  User?               @relation(fields: [userId], references: [id], onDelete: Restrict)
  status                PaymentRecordStatus @default(MOCK)
  kind                  PaymentRecordKind?
  provider              String?
  providerId            String?
  stripePaymentIntentId String?             @unique
  stripeChargeId        String?
  stripeTransferId      String?
  stripeRefundId        String?
  amount                Float?
  amountMinor           Int?
  applicationFeeMinor   Int?
  currency              String              @default("ARS")
  /// Cuánto de este cobro ya se devolvió. Una devolución parcial deja el
  /// registro en PARTIALLY_REFUNDED y este número es el que dice cuánta plata
  /// sigue siendo nuestra; sin él, dos devoluciones parciales podrían sumar
  /// más que el cobro original y nadie se enteraría.
  refundedAmountMinor   Int                 @default(0)

  /// ── LO QUE PERMITE RECONSTRUIR UN COBRO DISCUTIDO ────────────────────────
  ///
  /// Nada de esto es el número de tarjeta, que nunca pasa por este servidor:
  /// son las señas que devuelve el procesador y que sirven para responder
  /// "¿quién pagó esto y desde dónde?" cuando alguien desconoce un cobro.
  ///
  /// `cardFingerprint` es el identificador estable que Stripe le da a UNA
  /// tarjeta: la misma tarjeta en dos cuentas distintas tiene el mismo
  /// fingerprint. Es lo que permite ver que cinco cuentas nuevas están pagando
  /// todas con el mismo plástico, que es la forma que tiene el fraude de
  /// verse desde acá.
  cardBrand          String?
  cardLast4          String?
  cardFingerprint    String?
  cardCountry        String?
  /// Evaluación de riesgo del procesador (Stripe Radar): "normal", "elevated",
  /// "highest", y su puntaje 0-100.
  riskLevel          String?
  riskScore          Int?
  /// Desde dónde se pidió este cobro. La IP y el navegador del pedido que
  /// creó el intent, no los del webhook (ese lo manda Stripe).
  initiatedIp        String?
  initiatedUserAgent String?
  /// Por qué falló, tal como lo dijo el procesador ("card_declined",
  /// "insufficient_funds"). Se guarda el código y el mensaje: el código es
  /// para que el front ramifique, el mensaje para el soporte.
  failureCode        String?
  failureMessage     String?

  metadata   Json?
  paidAt     DateTime?
  capturedAt DateTime?
  releasedAt DateTime?
  refundedAt DateTime?
  disputedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  events PaymentEvent[]

  @@index([bookingId])
  @@index([userId])
  @@index([status])
  @@index([kind])
  @@index([cardFingerprint])
}

/// CADA COSA QUE LE PASÓ A UN COBRO, EN ORDEN Y SIN PISARSE.
///
/// `PaymentRecord` guarda el estado de AHORA; esto guarda cómo se llegó. Son
/// dos preguntas distintas y antes solo se podía responder la primera: un
/// registro que decía REFUNDED no dejaba ver si se había cobrado y devuelto, o
/// si el cobro había fallado tres veces antes, ni cuándo, ni por orden de
/// quién.
///
/// Es APPEND-ONLY: nada de acá se edita ni se borra. Es lo que lo hace servir
/// para lo que existe —responder un desconocimiento de cobro, reconstruir una
/// disputa, ver un patrón de fraude—, porque un registro que se puede reescribir
/// no prueba nada.
///
/// `payload` guarda el objeto del procesador tal como llegó, que es la prueba
/// de lo que dijo. No lleva datos de tarjeta más allá de los últimos cuatro
/// dígitos: eso Stripe no lo manda y nosotros no lo pedimos.
model PaymentEvent {
  id              String               @id @default(uuid())
  paymentRecordId String?
  paymentRecord   PaymentRecord?       @relation(fields: [paymentRecordId], references: [id], onDelete: Restrict)
  bookingId       String?
  /// Quién lo provocó: el id del usuario, o null cuando lo provocó el
  /// procesador (un webhook) y no una persona.
  actorId         String?
  /// De dónde vino: "api" (un pedido nuestro), "webhook" (Stripe nos avisó),
  /// "system" (una tarea nuestra).
  source          String
  /// Qué pasó: "intent.created", "intent.succeeded", "intent.failed",
  /// "hold.authorized", "hold.captured", "hold.released", "refund.created",
  /// "transfer.created", "dispute.opened"...
  type            String
  /// En qué estado quedó el cobro después de esto.
  status          PaymentRecordStatus?
  amountMinor     Int?
  currency        String?
  /// Id del evento del procesador, único: es lo que hace que reprocesar el
  /// mismo webhook no escriba dos veces la misma línea.
  providerEventId String?              @unique
  ip              String?
  userAgent       String?
  payload         Json?
  createdAt       DateTime             @default(now())

  @@index([paymentRecordId, createdAt])
  @@index([bookingId, createdAt])
  @@index([type])
  @@index([createdAt])
}

model MediaAsset {
  id              String           @id @default(uuid())
  ownerId         String
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  entityType      String?
  entityId        String?
  kind            MediaAssetKind
  url             String
  storageProvider String?
  storageKey      String?
  mimeType        String?
  sizeBytes       Int?
  status          MediaAssetStatus @default(ACTIVE)
  // En qué lugar de la fila va este archivo. Para las fotos de un auto no es un
  // detalle: la primera es la portada, y la portada es lo que se ve en el
  // buscador, en el inicio, en el globo del mapa y en "Mis autos".
  //
  // Hasta acá el orden era el de subida (createdAt), o sea el que salió del
  // explorador de archivos al elegirlas: nadie lo decidió, y no se podía
  // cambiar sin borrar el aviso y cargarlo de nuevo.
  //
  // Arranca en 0 para todo lo que ya está guardado. Con todas empatadas, el
  // desempate por createdAt deja el orden EXACTAMENTE como estaba: ninguna
  // publicación existente cambia de portada al aplicar esta migración.
  position        Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([ownerId])
  @@index([entityType, entityId])
  @@index([kind])
  @@index([status])
}

model AuditLog {
  id           String   @id @default(uuid())
  actorId      String?
  targetUserId String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  targetUser   User?    @relation("AuditTargetUser", fields: [targetUserId], references: [id], onDelete: Restrict)
  action       String
  entityType   String
  entityId     String?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([actorId])
  @@index([targetUserId])
  @@index([entityType, entityId])
  @@index([action])
  @@index([createdAt])
}

model Conversation {
  id            String    @id @default(uuid())
  listingId     String
  listing       Listing   @relation(fields: [listingId], references: [id], onDelete: Restrict)
  renterId      String
  renter        User      @relation("RenterConversations", fields: [renterId], references: [id], onDelete: Restrict)
  ownerId       String
  owner         User      @relation("OwnerConversations", fields: [ownerId], references: [id], onDelete: Restrict)
  messages      Message[]
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([listingId, renterId])
  @@index([renterId])
  @@index([ownerId])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Restrict)
  type           MessageType  @default(TEXT)
  content        String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId])
  @@index([senderId])
}

model StripeEvent {
  id          String    @id @default(uuid())
  eventId     String    @unique
  type        String
  payload     Json
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([type])
}

model Contract {
  id               String         @id @default(uuid())
  bookingId        String         @unique
  booking          Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  status           ContractStatus @default(PENDING_ACCEPTANCE)
  terms            Json
  pdfStorageKey    String?
  pdfUrl           String?
  renterAcceptedAt DateTime?
  ownerAcceptedAt  DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status])
}

/// Reseña de una reserva terminada.
///
/// Solo se puede escribir cuando la reserva llegó a COMPLETED y el pago se
/// completó: es lo que hace que las puntuaciones signifiquen algo. Las dos partes
/// pueden reseñarse una a la otra por la misma reserva, y cada una puede escribir
/// una sola (de ahí el unique de reserva + autor).
model Review {
  id           String   @id @default(uuid())
  bookingId    String
  authorId     String
  targetUserId String
  /// La publicación que se está puntuando. Va cargada SOLO en la reseña que
  /// escribe quien alquiló: es la que habla del auto y cuenta para el promedio de
  /// la publicación. La que escribe el dueño es sobre la persona, así que queda
  /// en null y no ensucia la puntuación del aviso.
  listingId    String?
  /// Puntuación de 1 a 5.
  rating       Int
  comment      String?
  /// Características elegidas al reseñar: RESPONDE_RAPIDO, AUTO_SUCIO, etc.
  /// (ver src/reviews/review-tags.ts). Se guarda el CÓDIGO y no la frase por dos
  /// motivos: la misma reseña se lee en los cinco idiomas del front, y sobre
  /// todo, un código se puede CONTAR. Es lo que convierte veinte reseñas en un
  /// dato ("contesta rápido, 18 veces") en vez de veinte textos para leer uno
  /// por uno. Vacío por defecto: elegirlas nunca es obligatorio.
  tags         String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  author     User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  targetUser User     @relation("ReviewTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  listing    Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, authorId])
  @@index([listingId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([authorId])
}

/// Reporte de una persona sobre una publicación o sobre otra persona.
///
/// Antes el botón "Reportar" no guardaba nada en ninguna parte. Ahora queda
/// registrado, lo lee la IA para decir si lo denunciado tiene relación con la
/// publicación, y le llega a las cuentas administradoras para que puedan actuar.
model Report {
  id           String           @id @default(uuid())
  reporterId   String
  targetType   ReportTargetType
  listingId    String?
  targetUserId String?
  reason       String
  details      String?
  status       ReportStatus     @default(OPEN)

  /// Fotos o documentos que la persona sube como PRUEBA de lo que denuncia
  /// (URLs de Cloudinary). Sin al menos una, el reporte no se puede enviar: un
  /// reporte sin evidencia es la palabra de uno contra la del otro, y deja al
  /// admin sin nada con que decidir si pausar una publicación o suspender una
  /// cuenta.
  evidenceUrls String[]

  /// Lectura automática del reporte contra el contenido de la publicación.
  aiVerdict   ReportAiVerdict?
  aiSummary   String?
  aiCheckedAt DateTime?

  /// Resolución del admin.
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reporter   User     @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser User?    @relation("ReportedUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  listing    Listing? @relation(fields: [listingId], references: [id], onDelete: Cascade)
  resolvedBy User?    @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([listingId])
  @@index([reporterId])
}
