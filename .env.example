DATABASE_URL="postgresql://user:password@host:5432/freewheel?sslmode=require"
# DIRECT_URL: OPCIONAL. Conexión directa (sin pooler) que Prisma usa para las
# migraciones. Si no se define, se usa DATABASE_URL automáticamente, así que no
# hace falta crearla. Solo tiene sentido cargarla si el proveedor de la base usa
# un pooler que no admite migraciones (Supabase con el puerto 6543, Neon).
DIRECT_URL=""
JWT_SECRET="replace-with-a-secure-secret"
JWT_EXPIRES_IN="24h"
PORT=3000
LOCAL_API_URL="http://localhost:3000"
API_BASE_URL=""
FRONTEND_URL=""
CORS_ORIGINS=""
TARGET_URL=""
TEST_EMAIL=""
TEST_PASSWORD=""
FUNCTIONAL_TEST_TIMEOUT_MS=10000
DEPLOY_VERIFY_ATTEMPTS=5
DEPLOY_VERIFY_DELAY_MS=15000
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# ── Verificación de identidad ────────────────────────────────────────────────
# SMS_PROVIDER: por dónde salen los códigos para verificar el teléfono.
#
#   "mock"   (por defecto) → no se manda ningún SMS: el código llega al EMAIL de
#            la persona. La verificación funciona igual, el número queda
#            confirmado en la base, y no cuesta nada.
#   "twilio" → SMS de verdad. Necesita las tres variables de abajo; sin alguna,
#            la app NO ARRANCA (a propósito: con la configuración a medias la
#            falla aparecería recién cuando alguien intente verificar su
#            teléfono, y el que se la come es un usuario esperando un SMS que
#            nunca salió).
SMS_PROVIDER="mock"

# Solo con SMS_PROVIDER="twilio". Los dos primeros están arriba de todo en la
# consola de Twilio; el tercero es el número que te dieron.
#
# OJO con la cuenta de prueba: los SMS solo llegan a números verificados en la
# consola de Twilio, y el texto llega con un prefijo suyo. Para probar el
# circuito con el teléfono propio alcanza.
#
# En vez de TWILIO_FROM_NUMBER se puede usar TWILIO_MESSAGING_SERVICE_SID (MG...)
# si el envío se hace desde un Messaging Service. Va uno de los dos, no los dos.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# REQUIRE_PHONE_VERIFICATION: ¿el teléfono confirmado es obligatorio para que la
# cuenta quede verificada (y pueda publicar y reservar)? Por defecto NO, porque
# depende de un envío que puede fallar o costar. Ponelo en "true" cuando haya
# una pasarela de SMS contratada.
REQUIRE_PHONE_VERIFICATION="false"

# VERIFICATION_CODE_IN_RESPONSE: solo para la demo. Con "true" (y sin pasarela de
# SMS) la API devuelve el código del teléfono en la respuesta y la pantalla lo
# muestra, para poder completar el circuito sin esperar el mail. En una app de
# verdad esto va en "false".
VERIFICATION_CODE_IN_RESPONSE="false"

# Las fotos del DNI y la licencia se revisan A MANO: el backend las guarda y un
# admin las aprueba o las rechaza en PATCH /admin/verifications/:id/review. No
# hay nada que configurar. La lectura automática de documentos corre en un
# servicio aparte —ver docverify-api/— que se deploya por su cuenta y tiene su
# propio .env: este backend no lo llama ni sabe dónde está.

# ⚠️ VERIFICATION_DEMO_MODE — TEMPORAL, PARA REVERTIR ⚠️
#
# Relaja los controles de verificación para poder recorrer todos los flujos
# desde el front sin quedar trabado. Con el modo ENCENDIDO:
#
#   · la edad mínima baja de 18 a 17 años;
#   · ser principiante deja de impedir alquilar;
#   · no se mira el vencimiento de los documentos (ni para aprobarlos ni para
#     alquilar);
#   · la clase de la licencia deja de importar;
#   · de los datos que hay que poder leer queda solo nombre, apellido y número
#     de documento, y el DNI deja de exigir su código (PDF417 o QR).
#
# Lo que SIGUE exigiendo —y es a propósito, porque si no probar el flujo no
# demostraría nada— es que el nombre, el apellido, el DNI y el CUIL digan lo
# mismo en el documento y en la cuenta, y que el documento no se contradiga a
# sí mismo. Tampoco toca el antifraude del documento ya verificado en otra
# cuenta: para probar con varias cuentas hay que usar un DNI distinto en cada
# una.
#
# VIENE ENCENDIDO SIN CONFIGURAR NADA. Se apaga con "false", y se saca del todo
# revirtiendo el commit que trajo src/common/demo-mode.ts.
#
#   VERIFICATION_DEMO_MODE="false"
VERIFICATION_DEMO_MODE=""

# Vida del token de onboarding (verificar email / completar fecha de nacimiento).
ONBOARDING_JWT_EXPIRES_IN="30m"
# ── Servicios que ANTES estaban en el front y ahora viven acá ────────────────
# Estas tres cosas estaban en el navegador (VITE_*), o sea a la vista de
# cualquiera que abriera el código de la página. Ahora las usa solo el backend:
#   · GROQ_API_KEY   → chatbot, autocompletar specs, revisión de fotos de autos
#                      y audio (la verificación documental NO la usa: las fotos
#                      del DNI y la licencia las revisa un admin a mano)
#   · CLOUDINARY_*   → firma las subidas de fotos (el secreto no sale de acá)
# El front ya no necesita NINGUNA clave.
GROQ_API_KEY=""
# GROQ_VISION_MODEL: OPCIONAL. El modelo que mira las fotos de los autos. Se pueden poner varios separados por coma y se prueban en ese orden.
# Sin esto se usan los del código (hoy: qwen/qwen3.6-27b y, de respaldo, los dos
# llama-4 que Groq dio de baja en junio de 2026).
# Groq cambia los modelos que ofrece cada pocos meses, así que en vez de adivinar:
# Panel admin -> "Modelos de la revisión por IA" -> "Probar los modelos". Dice cuál
# contesta HOY, y ahí se copia ese nombre. Ver VARIABLES-VERCEL.md.
GROQ_VISION_MODEL=""

# CORS_STRICT: por defecto la API contesta a CUALQUIER origen. Se abrió a
# propósito para poder probar desde un HTML suelto sin cargar variables ni
# redeployar. El token viaja en la cabecera Authorization (no en una cookie),
# así que un sitio ajeno no puede usar la sesión de quien lo visita; lo que sí
# queda expuesto son las rutas públicas que gastan cuota de la API key (el
# chatbot), acotadas solo por el tope por IP.
# Con CORS_STRICT="true" vuelve la lista blanca de abajo (CORS_ORIGINS, o el
# front de producción + los puertos de desarrollo + las vistas previas).
# Si alguna vez se pasa a autenticar con cookies, esto hay que cerrarlo sí o sí.
CORS_STRICT=""

# DEMO_ORIGINS: OPCIONAL. Solo tiene efecto con CORS_STRICT="true". Orígenes extra que pueden llamar a la API
# desde un navegador, además de los de CORS_ORIGINS. Existe para poder abrir el
# front de prueba de la verificación de documentos —un HTML suelto servido en
# localhost— contra el backend desplegado, sin tocar la lista de producción.
# Ejemplo: DEMO_ORIGINS="http://localhost:8080"
DEMO_ORIGINS=""
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Lectura automática de documentos ─────────────────────────────────────────
# El servicio que lee el DNI y la licencia (docverify-api/), deployado aparte en
# Hugging Face Spaces. No entra en una función serverless —son ~300 MB de
# dependencias nativas— y necesita 2 GB de RAM.
#
# SIN ESTO TODO SIGUE FUNCIONANDO: las fotos se guardan igual y las revisa un
# administrador. La lectura automática acelera la verificación, no la habilita.
#
# DOCVERIFY_URL: dónde escucha el servicio, SIN barra final.
#
# HOY CORRE EN LOCAL, junto con el backend:
#   DOCVERIFY_URL="http://127.0.0.1:8000"
#
# 127.0.0.1 y no la IP de tu red: es la misma siempre, en cualquier máquina y
# cualquier red, y no cambia cuando el router reparte direcciones de nuevo.
#
# OJO: esto solo funciona si el backend corre en la MISMA máquina. Un backend
# en Vercel no puede alcanzar una dirección privada —no hay ruta desde
# internet— por más que la variable esté bien escrita. Las alternativas están
# en docverify-api/README.md.
DOCVERIFY_URL=""
# DOCVERIFY_TOKEN: la clave compartida, y lo ÚNICO que separa "a esta API la
# llama solo mi backend" de "la llama cualquiera que sepa la URL". Por ahí
# pasan documentos de identidad de personas reales, así que el servicio
# publicado se niega a arrancar sin ella.
#
# Tiene que ser EXACTAMENTE la misma de los dos lados:
#   · acá, en el backend;
#   · en el servicio de lectura (su propia variable DOCVERIFY_TOKEN, cargada
#     como secreto en el panel de la plataforma — en Hugging Face, en
#     Settings › Variables and secrets).
# Si no coinciden, este backend recibe 401 en cada pedido y TODOS los
# documentos terminan en revisión manual, sin que nada diga por qué. Con la
# variable vacía el backend avisa al arrancar y lo informa en
# GET /verification/identity/diagnostics (`readerTokenConfigured`).
#
# Generala así, y no a mano:
#   openssl rand -hex 32
#
# Viaja en el header X-Docverify-Token (y también en Authorization, para los
# hosts que solo miran ese).
#
# QUIÉN MÁS LA NECESITA: el HTML de prueba de public/demo/verificacion.html,
# que le habla al lector directo desde el navegador. Se pega en el campo
# «lector · DOCVERIFY_TOKEN» del encabezado; no se hornea en el archivo, así
# que servir la demo no reparte la clave.
#
# Y para que el navegador pueda llegar, el lector tiene que tener el origen de
# la demo en SU variable DOCVERIFY_ORIGENES (ver docverify-api/.env.example):
#   DOCVERIFY_ORIGENES="https://tu-backend.vercel.app,http://localhost:3000"
# Los pedidos que hace ESTE backend salen del servidor, donde CORS no
# interviene, así que esa lista es solo para la demo.
DOCVERIFY_TOKEN=""

# Solo si el Space es PRIVADO: el token de Hugging Face con permiso de lectura.
# Un Space privado se protege con la autenticación de la plataforma, que ocupa
# el header Authorization; por eso el token propio viaja en otro header y los
# dos conviven. Con un Space público esto se deja vacío.
DOCVERIFY_PLATFORM_TOKEN=""

# A dónde le avisa el servicio de lectura cuando termina de analizar. Tiene que
# ser una URL alcanzable desde internet: el análisis tarda más de lo que dura un
# request, así que el resultado vuelve por acá y no en la misma respuesta.
#
# En Vercel NO hace falta: se arma sola con VERCEL_URL. Solo se completa cuando
# el backend corre en otro lado, o cuando hay un dominio propio que se prefiere
# al de Vercel. Sin ninguna de las dos, el análisis ni se pide (no habría a
# dónde devolverlo) y todo pasa a revisión manual.
PUBLIC_URL=""

# Stripe (SOLO modo test). El provider Stripe rechaza arrancar si STRIPE_SECRET_KEY
# no es una clave de test (sk_test_/rk_test_): no puede cobrar dinero real.
# PAYMENTS_PROVIDER=mock usa el provider determinista offline (sin red).
PAYMENTS_PROVIDER="mock"
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_API_VERSION=""
STRIPE_CONNECT_ENABLED="true"
# Parámetros económicos (cálculo server-side). Porcentajes como fracción (0.10 = 10%).
PLATFORM_FEE_PCT="0.10"
INSURANCE_PCT="0.10"
SENA_PCT="0.30"
DEPOSIT_DEFAULT_USD="200"
DEFAULT_CURRENCY="usd"

# PRICE_CHANGE_COOLDOWN_HOURS: cada cuántas horas se puede cambiar el precio de
# una publicación. El cambio además exige confirmar con un código que llega al
# email y no se permite con reservas en curso (ver src/listings/price-change.service.ts).
PRICE_CHANGE_COOLDOWN_HOURS="24"

# ── Lectura automática de documentos ─────────────────────────────────────────
#
# NO se configura acá. Vive en docverify-api/, es un servicio de Python
# independiente con su propio .env (ver docverify-api/.env.example) y se
# deploya aparte. Este backend no le pega: recibe las fotos, las guarda y las
# deja para que un admin las revise.

# ── Panel de administración ──────────────────────────────────────────────────
#
# ALLOW_ACCOUNT_HARD_DELETE: si un admin puede BORRAR cuentas de verdad
# (DELETE /admin/users/:id), en vez de solo suspenderlas o darlas de baja.
#
# SON DOS ACCIONES DISTINTAS Y LAS DOS HACEN FALTA:
#
#  · SUSPENDER / DAR DE BAJA (PATCH /admin/users/:id/status) saca a la cuenta de
#    circulación pero la deja existiendo, así sus datos únicos —email, teléfono,
#    DNI, CUIL— QUEDAN TOMADOS y quien fue expulsado no se registra de nuevo con
#    los mismos. Ese es el castigo y es el camino normal.
#  · BORRAR (DELETE /admin/users/:id) elimina la cuenta y todo lo suyo, y LIBERA
#    esos datos. Hace falta para reciclar cuentas de prueba y para atender un
#    pedido real de borrado de datos.
#
# POR DEFECTO ESTÁ HABILITADO. Antes estaba apagado en producción, y como la
# única instalación que existe corre con NODE_ENV=production, el botón no
# aparecía en ninguna parte: la protección terminaba apagando la función entera
# en el único lugar donde se usa.
#
# La protección contra borrar por error no está acá: está en el panel, que
# muestra las dos acciones con nombres distintos y para borrar exige ESCRIBIR EL
# EMAIL de la cuenta.
#
# Ponerla en "false" apaga el borrado, para una instalación donde se decida que
# las cuentas no se borran nunca. Cualquier otro valor la deja habilitada.
ALLOW_ACCOUNT_HARD_DELETE=""
