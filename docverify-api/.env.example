# Deploy: HosTICer, app freewheel/api (receta fastapi-ocr: Python 3.13, 2 CPU, 1 GB).
# URL pública: https://proyectos-tic.ort.edu.ar/freewheel/api
# El backend usa DOCVERIFY_URL=https://proyectos-tic.ort.edu.ar/freewheel/api (SIN barra
# final) y el MISMO DOCVERIFY_TOKEN que se configura acá.
DOCVERIFY_TOKEN=
DOCVERIFY_ORIGENES=
DOCVERIFY_MAX_KB=15000
DOCVERIFY_CONCURRENCIA=1
DOCVERIFY_COLA_MAXIMA=8
DOCVERIFY_CALLBACK_TIMEOUT=20
DOCVERIFY_LADO_MAXIMO=2400
# Hilos de onnxruntime por llamada al OCR (mínimo 1). Igual a las CPU del contenedor.
OMP_NUM_THREADS=2
# main.py ya lo pone por defecto: onnxruntime no escribe telemetría en $HOME.
ORT_DISABLE_TELEMETRY=1
