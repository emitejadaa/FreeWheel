# ─────────────────────────────────────────────────────────────────────────────
# Configuración del contenedor. Copiar a `.env` y editar:
#
#     cp .env.docker.example .env
#
# El archivo `.env` NO se versiona (está en .gitignore): es donde vive el
# token de producción.
#
# Solo hay UNA variable obligatoria, DOCVERIFY_TOKEN. Todas las demás tienen un
# default razonable y se pueden dejar vacías o borradas.
# ─────────────────────────────────────────────────────────────────────────────


# ── OBLIGATORIA ──────────────────────────────────────────────────────────────

# La clave compartida. Todo pedido tiene que traerla, en
# `Authorization: Bearer <token>` o en el header `X-Docverify-Token`.
#
# Si queda vacía, EL CONTENEDOR NO ARRANCA y lo dice en el log. No es un
# capricho: por esta API pasan fotos de documentos de identidad de personas
# reales, y sin token alcanza con conocer la URL para mandarle cualquier cosa.
#
# Generar una al azar (cualquiera de las dos sirve):
#     openssl rand -hex 32
#     python -c "import secrets; print(secrets.token_hex(32))"
DOCVERIFY_TOKEN=""


# ── HTTPS (solo si se usa docker-compose.https.yml) ──────────────────────────

# El dominio que apunta a este servidor. Sin las comillas y sin "https://":
#     DOMINIO=docverify.midominio.com
DOMINIO=""

# Mail para que Let's Encrypt avise si una renovación falla. ES OPCIONAL y
# viene vacío: el certificado se emite y se renueva igual sin él. Para usarlo
# hay que completarlo ACÁ y además descomentar el bloque `email` del Caddyfile
# (está explicado ahí mismo).
ACME_EMAIL=""


# ── OPCIONALES ───────────────────────────────────────────────────────────────

# Desde qué orígenes puede llamar un NAVEGADOR (CORS), separados por coma.
# Vacío = ninguno, que es el default correcto acá: el backend llama a esta API
# desde su servidor, y ahí CORS no interviene. Solo hace falta poner algo si
# una página web va a llamar a esta API directamente desde el browser.
#     DOCVERIFY_ORIGENES=https://freewheel.vercel.app,http://localhost:3000
DOCVERIFY_ORIGENES=""

# Tamaño máximo de imagen aceptado, en KB. Una foto de teléfono sin comprimir
# ronda los 2.000-4.000 KB. Default: 15000.
DOCVERIFY_MAX_KB=""

# Cuántos análisis corren A LA VEZ. Default: 1.
#
# Subirlo pide MÁS MEMORIA, no más CPU: cada análisis trabaja sobre imágenes
# descomprimidas y dos a la vez no entran en 1 GB. Con 4 GB de RAM en el
# servidor se puede probar con 2; con menos, dejarlo en 1.
DOCVERIFY_CONCURRENCIA=""

# Cuántos análisis se aceptan sin terminar antes de empezar a contestar 503.
# Acota cuánto puede llegar a esperar el que ya está en la fila. Default: 8.
DOCVERIFY_COLA_MAXIMA=""

# Segundos de espera al avisarle al backend que un análisis terminó.
# Default: 20.
DOCVERIFY_CALLBACK_TIMEOUT=""

# Tope del lado más largo de la foto que entra, en píxeles. Default: 2400.
DOCVERIFY_LADO_MAXIMO=""
