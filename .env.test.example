# Copy this file to .env.test and point DATABASE_URL at a DISPOSABLE Postgres
# (a local Docker container or a throwaway Neon TEST branch). The E2E suite
# wipes every table between tests and re-syncs the schema with `prisma db push`
# on start — never point this at your dev or production database.
#
# Quick local DB via Docker:
#   docker run -d --name freewheel-pg -e POSTGRES_PASSWORD=postgres \
#     -e POSTGRES_USER=postgres -e POSTGRES_DB=freewheel -p 5433:5432 postgres:16
#   docker exec freewheel-pg psql -U postgres -c "CREATE DATABASE freewheel_test;"

DATABASE_URL="postgresql://postgres:postgres@localhost:5433/freewheel_test"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/freewheel_test"
JWT_SECRET="test-secret-change-me"
NODE_ENV="test"

# Required acknowledgement that DATABASE_URL above is a throwaway test database.
# Without this set to "true", the suite refuses to run.
ALLOW_DB_RESET="true"

# Stripe runs in TEST mode only. In E2E the provider is mocked, so these can be
# dummy values; they only need the test prefixes so the live-key guard passes.
STRIPE_SECRET_KEY="sk_test_dummy_for_tests"
STRIPE_WEBHOOK_SECRET="whsec_dummy_for_tests"
STRIPE_PUBLISHABLE_KEY="pk_test_dummy"
STRIPE_API_VERSION="2024-06-20"
PAYMENTS_PROVIDER="stripe"

# Economic parameters (server-side money math).
PLATFORM_FEE_PCT="0.10"
INSURANCE_PCT="0.10"
SENA_PCT="0.30"
DEPOSIT_DEFAULT_USD="200"
DEFAULT_CURRENCY="usd"
STRIPE_CONNECT_ENABLED="true"
