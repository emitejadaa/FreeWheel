# Copy this file to .env.test and point DATABASE_URL at a DISPOSABLE Neon TEST
# branch (or any throwaway Postgres). The E2E suite DELETES every table between
# tests — never point this at your dev or production database.

DATABASE_URL="postgresql://user:password@host/freewheel_test?sslmode=require"
JWT_SECRET="test-secret-change-me"
NODE_ENV="test"

# Required acknowledgement that DATABASE_URL above is a throwaway test database.
# Without this set to "true", the suite refuses to run.
ALLOW_DB_RESET="true"
